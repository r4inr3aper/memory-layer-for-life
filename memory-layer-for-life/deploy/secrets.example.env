# Secrets for one deployed environment (staging or production).
#
# Copy this file to deploy/staging.secrets.env or deploy/production.secrets.env (both are
# gitignored), fill it in, and import it with:
#   .\deploy\deploy.ps1 staging -ImportSecrets
# Each environment gets its own values: its own database, and ideally its own API keys,
# so a staging mistake can never spend production's budget or touch its data. After the
# import, Fly holds them encrypted; delete the file or keep it in a password manager.
# Settings that are not secret live in fly.<environment>.toml instead.

# --- Required ----------------------------------------------------------------------------

# Neon: the environment's own database, direct (not pooled) host, TLS required.
# production: the existing project's main branch. staging: a separate Neon project.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-NAME.us-east-2.aws.neon.tech/neondb?ssl=require

# Supabase Auth, used to verify who is signed in. One project can serve every environment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anthropic. Use a key from a workspace per environment, each with a spend limit
# (console.anthropic.com > Settings > Workspaces).
ANTHROPIC_API_KEY=sk-ant-...

# --- Strongly recommended ----------------------------------------------------------------

# Who may use this deployment, as a JSON list. Without it anyone with a Google account
# can sign in and spend the daily prompt limit on your Anthropic key.
ACCESS_ALLOWED_EMAILS=["you@example.com"]

# Opens the operator routes (memory layer, call log, evaluations) with the X-Operator-Key
# header. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty: the operator routes are closed to everyone.
OPERATOR_API_KEY=

# --- Optional: each one turns a feature on ------------------------------------------------

# Deleting an account also deletes its Supabase sign-in (sb_secret_...).
SUPABASE_SECRET_KEY=
# Connected apps (Gmail, Slack, Calendar, ...). A separate Composio project for staging
# keeps test connections apart from real ones.
COMPOSIO_API_KEY=
# Browser tasks.
BROWSERBASE_API_KEY=
# Memory search by meaning (embeddings). Without it, search uses words and names.
VOYAGE_API_KEY=
# Only if "Enhanced push security" is on for the Expo project.
EXPO_PUSH_ACCESS_TOKEN=

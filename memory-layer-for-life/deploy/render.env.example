# Production settings for the free deployment on Render (docs/DEPLOYMENT.md, "Free").
#
# Copy to deploy/render.env (gitignored), fill in the secrets, then paste the whole file
# into Render: your service > Environment > Add from .env. Render keeps the values
# encrypted; delete the local copy afterwards or keep it in a password manager.

# --- Behaviour (not secret) ----------------------------------------------------------
ENVIRONMENT=production
APP_NAME=muse-api
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata
ANTHROPIC_MODEL=claude-haiku-5-5
ASSISTANT_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT=30
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_REFUSAL_FALLBACK=false
ASSISTANT_DAILY_PROMPT_LIMIT=40
USAGE_CURRENCY=INR
USAGE_CURRENCY_PER_USD=88
CORS_ORIGINS=[]
# The free instance is small (512 MB); a few connections are plenty.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
# Neon's free plan counts every minute the database is awake (100 compute-hours a month).
# Background jobs then run at their normal pace only while you use the app, and otherwise
# wake together once an hour or exactly when something is due, so the database sleeps in
# between and reminders and schedules still run on time.
BACKGROUND_IDLE_INTERVAL_SECONDS=3600
BACKGROUND_ACTIVE_WINDOW_SECONDS=120
# Render's free plan has no release step, so the image migrates the database on start.
MIGRATE_ON_START=true

# --- Secrets (required) ----------------------------------------------------------------
# Neon: your project's direct connection URL, pasted as Neon shows it.
DATABASE_URL=postgresql://USER:PASSWORD@ep-NAME.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
ANTHROPIC_API_KEY=sk-ant-...
# Only these Google accounts may use the app.
ACCESS_ALLOWED_EMAILS=["you@example.com"]
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPERATOR_API_KEY=

# --- Optional: uncomment the ones you use ----------------------------------------------
# SUPABASE_SECRET_KEY=
# COMPOSIO_API_KEY=
# VOYAGE_API_KEY=
# BROWSERBASE_API_KEY=

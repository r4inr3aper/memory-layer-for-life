APP_NAME=second-brain
# development (this computer), staging, or production (deployed; see docs/DEPLOYMENT.md at
# the repository root), or testing (the test suite). A deployed API refuses to start
# without a hosted database over TLS, SUPABASE_URL, and ANTHROPIC_API_KEY, and its
# operator routes accept only OPERATOR_API_KEY.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL. A hosted database needs the direct host and ?ssl=require, for example on Neon:
# postgresql+asyncpg://USER:PASSWORD@ep-NAME.REGION.aws.neon.tech/neondb?ssl=require
# On Supabase use the direct connection or the session pooler (port 5432), never the
# transaction pooler (6543). Tests never use this; they use the local second_brain_test.
DATABASE_URL=postgresql+asyncpg://brain:brain_dev_password@localhost:5432/second_brain
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Anthropic. Without a key the API still captures messages; they wait in the queue.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT=60
ANTHROPIC_MAX_RETRIES=2
# Retry a note the model declines on Anthropic's recommended fallback model. It is only
# requested from models that have one (claude-haiku-5-5 does not), so it is safe to leave on.
ANTHROPIC_REFUSAL_FALLBACK=true

# Extraction
EXTRACTION_EFFORT=medium
EXTRACTION_MAX_TOKENS=16000
# IANA timezone you write your notes in. Used to read words like "tomorrow" correctly.
DEFAULT_TIMEZONE=UTC

# Pipeline reliability
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_RETRY_BASE_SECONDS=30
PIPELINE_RETRY_MAX_SECONDS=900
PIPELINE_RUN_LEASE_SECONDS=600
# The API retries failed and interrupted memory saves itself while this is true.
PIPELINE_WORKER_ENABLED=true
PIPELINE_WORKER_INTERVAL_SECONDS=30
PIPELINE_WORKER_BATCH_SIZE=10

# Ingestion limits
INGESTION_MAX_UNIT_MESSAGES=20
INGESTION_MAX_BATCH_UNITS=100
INGESTION_MAX_CONTENT_CHARS=20000

# Evaluation. The dataset path is relative to the project root unless absolute.
EVALUATION_DATASET_PATH=golden.jsonl
# A running evaluation that has scored no case for this long is marked interrupted.
EVALUATION_STALE_AFTER_SECONDS=900

# Console. The built web UI is served at / when this directory exists.
CONSOLE_UI_DIR=frontend/dist

# Supabase Auth. The mobile app signs users in with Supabase; the API verifies their access
# tokens against the project's published signing keys. Without SUPABASE_URL, every app
# route (/me, /threads, /schedules, /tools) answers 503.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional. Defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Who may use the app, as a JSON list of email addresses. Empty: everyone who signs in.
# A deployment reachable from the internet should list its people: anyone can create a
# Supabase sign-in with Google, and each user can spend the daily prompt limit.
ACCESS_ALLOWED_EMAILS=[]
# Optional, server-side only. The project's secret key (sb_secret_...), used for one thing:
# deleting a user's Supabase sign-in when they delete their account. Without it, account
# deletion still removes all their data here. Never put this key in the app.
SUPABASE_SECRET_KEY=

# Assistant (Cooper). The model defaults to ANTHROPIC_MODEL.
ASSISTANT_MODEL=
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_TOKENS=8000
ASSISTANT_MAX_STEPS=10
ASSISTANT_HISTORY_MESSAGES=40
CHAT_MAX_MESSAGE_CHARS=8000
# Files attached to a chat message (images and PDFs).
CHAT_MAX_ATTACHMENTS=3
CHAT_MAX_ATTACHMENT_BYTES=5242880
# How long a thread stays locked for a reply whose process died. Live replies unlock it
# as soon as they end.
CHAT_TURN_LEASE_SECONDS=600

# Prompts per user per UTC day. A prompt is a chat message sent or a scheduled run.
# 0 means unlimited. One user's own limit: UPDATE app_users SET daily_prompt_limit = ...
ASSISTANT_DAILY_PROMPT_LIMIT=40
# The currency the app shows costs in, and units of it per US dollar (a fixed rate, so
# costs are estimates). For dollars: USAGE_CURRENCY=USD and USAGE_CURRENCY_PER_USD=1.
USAGE_CURRENCY=INR
USAGE_CURRENCY_PER_USD=88

# Chats become memories (ADR-048): once a chat has been quiet for
# MEMORY_CAPTURE_QUIET_SECONDS, what the user said since the last capture goes through the
# memory pipeline as one unit, with the assistant's replies as context. Users can turn it
# off in the app. Memories the pipeline is sure of are accepted without review.
MEMORY_CAPTURE_ENABLED=true
MEMORY_CAPTURE_QUIET_SECONDS=300
MEMORY_AUTO_ACCEPT_ENABLED=true

# Documents the user uploads for the assistant to read (ADR-049). Scanned PDFs (no text
# layer) are read by the model only with DOCUMENT_VISION_FALLBACK=true: one model call each,
# counted as one of the day's prompts.
DOCUMENT_MAX_BYTES=10485760
# The original files are kept so the assistant can attach them to emails (ADR-050); this is
# how much one user's files may take together.
DOCUMENT_STORAGE_MAX_BYTES=52428800
DOCUMENT_VISION_FALLBACK=false

# Memory retrieval (ADR-038). Search always uses words and names; with a Voyage AI key it
# also finds memories by meaning. Without a key, leave it empty: nothing is embedded.
VOYAGE_API_KEY=
# voyage-4 (default), voyage-4-lite (cheaper), or voyage-4-large. Changing the model or the
# dimensions starts a new, empty index: run scripts/index_memories.py, then
# --prune-other-spaces once the new one is complete.
EMBEDDING_MODEL=voyage-4
# 256, 512, 1024, or 2048.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
# A cross-encoder that reorders the best results, for example rerank-2.5 or
# rerank-2.5-lite. Empty: no reranking. Costs one call per search.
RETRIEVAL_RERANK_MODEL=
# Below this cosine similarity a memory is not related at all. Measure with
# scripts/run_retrieval_eval.py --embedder voyage before changing it.
RETRIEVAL_MIN_SEMANTIC_SIMILARITY=0.3
# The API embeds new and changed memories in the background at this interval.
RETRIEVAL_INDEXER_ENABLED=true
RETRIEVAL_INDEXER_INTERVAL_SECONDS=15

# Connected apps as memory sources (ADR-047): upcoming calendar events become plans.
SOURCE_SYNC_ENABLED=true
SOURCE_SYNC_INTERVAL_SECONDS=21600

# Reminders and daily briefs (ADR-045). The API sends due ones itself while this is true.
PROACTIVE_ENABLED=true
PROACTIVE_POLL_SECONDS=60

# Scheduled tasks. The API dispatches due schedules itself while this is true.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
SCHEDULER_BATCH_SIZE=10
SCHEDULER_CONCURRENCY=3
SCHEDULE_RUN_STALE_SECONDS=1800
# A slot found later than this (the server was down, say) is skipped, not run late.
# Interval schedules use at most half their period.
SCHEDULE_MISSED_GRACE_SECONDS=3600

# Connected apps (Gmail, Slack, ...). Without a key the catalog lists but nothing connects.
# A project API key (ak_..., Composio: Settings > Project Settings > API Keys).
COMPOSIO_API_KEY=
# Connecting an app uses the project's auth config for it, or creates one with Composio's
# managed sign-in on first use. To use a specific one (e.g. your own OAuth app):
# COMPOSIO_AUTH_CONFIGS={"googlecalendar":"ac_..."}

# The operator routes (memory layer, console, call log, evaluations) answer only this
# computer. To call them from another one, set a long random key here and send it in
# the X-Operator-Key header. Empty: other computers are always refused.
OPERATOR_API_KEY=

# Browser tasks. Without a key the assistant has no browser.
BROWSERBASE_API_KEY=
BROWSERBASE_RUN_TIMEOUT_SECONDS=240

# Push notifications when a scheduled run ends, through Expo's push service. The access
# token is optional; set it only if "Enhanced push security" is on for the Expo project.
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=

INTEGRATION_TIMEOUT_SECONDS=30

# The largest request body the API reads (25 MB: three 5 MB files in base64 fit). Larger
# ones get 413 before they are buffered.
MAX_REQUEST_BYTES=26214400

# Interactive API docs at /docs. Empty: on everywhere except production.
# API_DOCS_ENABLED=false

# Expo web runs on 8081. Native apps do not need CORS.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081"]
